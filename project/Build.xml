				<lib name="-llzma" />

				<!-- Bibliotecas de texto -->
				<lib name="-lfreetype" />
				<lib name="-lharfbuzz" />

				<!-- Cairo y dependencias -->
				<lib name="-lcairo" />
				<lib name="-lpixman-1" />

				<!-- OpenSSL/MBEDTLS -->
				<lib name="-lmbedcrypto" />
				<lib name="-lmbedtls" />
				<lib name="-lmbedx509" />

				<!-- Otras dependencias -->
				<lib name="-lstdc++" />
				<lib name="-lm" />
			</section>

			<section if="rpi">
				<lib name="-ldl" />
				<lib name="-ldrm" />
				<lib name="-lm" />
				<lib name="-lEGL" />
				<lib name="-lGLESv2" />
			</section>

			<section if="tvos">
				<vflag name="-framework" value="UIKit" />
				<vflag name="-framework" value="Foundation" />
				<vflag name="-framework" value="AudioToolbox" />
				<vflag name="-framework" value="AudioUnit" />
