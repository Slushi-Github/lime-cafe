			</section>

			<!-- Sección específica para Wii U -->
			<section if="wiiu">
				<lib name="-L../ndll/WiiU" />

				<!-- Bibliotecas base de devkitPPC para Wii U -->
				<lib name="-lwut" />
				<lib name="-lpthread" />

				<!-- OpenAL: EXCLUIDO INTENCIONALMENTE para Wii U -->
				<!-- <lib name="-lopenal" /> -->

				<!-- Bibliotecas SDL para Wii U -->
				<lib name="-lSDL2" />
				<lib name="-lSDL2main" />
				<lib name="-lSDL2_image" />
				<lib name="-lSDL2_gfx" />
				<lib name="-lSDL2_net" />
